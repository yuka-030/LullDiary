{
  "name": "lulldiary",
  "devDependencies": {
    "@wdio/cli": "^9.31.7",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.7",
    "@wdio/mocha-framework": "^9.31.7",
    "@wdio/spec-reporter": "^9.31.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "6.0.2",
    "typescript-eslint": "^8.70.0",
    "webdriverio": "^9.31.7"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "serialize-javascript": "7.0.5",
    "diff": "8.0.3"
  },
  "private": true,
  "scripts": {
    "dev": "bun run setup:ollama && bun run setup:voicevox && concurrently \"bun run dev:server\" \"bun run dev:desktop\"",
    "dev:server": "bun run --cwd apps/server dev",
    "dev:desktop": "bun run --cwd apps/desktop tauri dev",
    "setup:ollama": "bun run --cwd apps/server setup:ollama",
    "setup:voicevox": "bun run --cwd apps/server setup:voicevox",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:server": "bun test --cwd apps/server",
    "test:e2e": "bun --env-file=apps/server/.env tests/e2e/run.mjs"
  },
  "type": "module",
  "workspaces": [
    "apps/*"
  ]
}
